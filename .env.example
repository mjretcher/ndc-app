# --- Database (required) ----------------------------------------------------
# Local dev:    postgres://ndc:ndc_dev@localhost:5432/ndc_dev
# Neon (prod):  copy the pooled connection string from the Neon dashboard
DATABASE_URL=

# --- Auth (required) --------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# Set to the public URL in production, e.g. https://app.napoleondiving.com
# AUTH_URL=
AUTH_TRUST_HOST=true

# --- Email ------------------------------------------------------------------
# Leave RESEND_API_KEY empty in dev: emails are logged to the server console
# and recorded in the notification log instead of being sent.
RESEND_API_KEY=
EMAIL_FROM="Napoleon Diving Club <noreply@example.com>"

# --- App --------------------------------------------------------------------
# Public base URL, used in emails that link back to the app (guides, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Seed overrides (optional, read by src/db/seed.ts) ----------------------
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=
