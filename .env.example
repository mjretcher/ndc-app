# --- Database (required) ----------------------------------------------------
# Local dev:    postgres://ndc:ndc_dev@localhost:5432/ndc_dev
# Neon (prod):  copy the pooled connection string from the Neon dashboard
DATABASE_URL=

# --- Auth (required) --------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# Set to the public URL in production, e.g. https://app.napoleondiving.com
# AUTH_URL=
AUTH_TRUST_HOST=true

# --- Email ------------------------------------------------------------------
# Delivery is chosen automatically: Resend if RESEND_API_KEY is set, else
# Gmail relay if GMAIL_USER + GMAIL_APP_PASSWORD are set, else emails are
# logged to the server console and recorded as "skipped" in the notification
# log rather than actually sent. Leave everything blank in local dev.

# Preferred long-term path, once a domain is verified with Resend:
RESEND_API_KEY=
EMAIL_FROM="Napoleon Diving Club <noreply@example.com>"

# Stopgap path: sends real email through a Gmail account today, no domain
# needed. GMAIL_USER is the full Gmail address; GMAIL_APP_PASSWORD is a
# 16-character App Password (Google Account > Security > 2-Step Verification
# > App passwords — requires 2-Step Verification to be turned on for the
# account first). Mail will read as coming from GMAIL_USER.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# --- App --------------------------------------------------------------------
# Public base URL, used in emails that link back to the app (guides, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Seed overrides (optional, read by src/db/seed.ts) ----------------------
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=

# --- Sign-up cutoff cron (required for /api/cron/check-signup-practices) ----
# Shared secret checked against the "Authorization: Bearer <value>" header.
# Set this to the SAME value in two places: Vercel project env vars (so the
# route can verify it) and the GitHub repo's Actions secrets (so the hourly
# workflow in .github/workflows/check-signup-practices.yml can send it).
# Generate with: openssl rand -base64 24
CRON_SECRET=
